#!/usr/bin/env sh
# Auto-generate a cute slide deck for each new commit and upload it to Google Drive.
#
# Wired up via:  git config core.hooksPath .githooks
# Disable with:  git config hooks.autoslides false   (re-enable: true / unset)
#
# Runs a headless `claude -p` in the background so `git commit` returns instantly.
# Logs land in .claude/skills/codebase-to-slides/logs/commit-<sha>.log

# Opt-out switch.
if [ "$(git config --bool hooks.autoslides 2>/dev/null)" = "false" ]; then
  exit 0
fi

# Don't recurse if a hook-spawned run ever commits.
if [ -n "$CLAUDE_SLIDES_HOOK" ]; then
  exit 0
fi

# Only deck *real code* commits. Skip commits that only touch the shared knowledge
# store (knowledge/ entries + session recaps from the knowledge-base Stop hook).
NONKNOWLEDGE="$(git diff-tree --no-commit-id --name-only -r HEAD | grep -v '^knowledge/' || true)"
if [ -z "$NONKNOWLEDGE" ]; then
  echo "[autoslides] commit only touches knowledge/ — skipping deck." >&2
  exit 0
fi

REPO="$(git rev-parse --show-toplevel)"

# Locate the claude CLI.
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
if [ ! -x "$CLAUDE_BIN" ]; then
  CLAUDE_BIN="$(command -v claude 2>/dev/null)"
fi
if [ -z "$CLAUDE_BIN" ]; then
  echo "[autoslides] claude CLI not found; skipping deck for this commit." >&2
  exit 0
fi

SHA="$(git rev-parse --short HEAD)"
LOG_DIR="$REPO/.claude/skills/codebase-to-slides/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/commit-$SHA.log"

PROMPT="Use the codebase-to-slides skill to generate a slide deck summarizing commit ${SHA} (HEAD) and upload it to Google Drive. Make it humorous, vivid, vibrant, and cute. Work fully non-interactively: do not ask any questions, and do NOT create any git commits."

# Detach so the commit isn't blocked by the model call.
CLAUDE_SLIDES_HOOK=1 nohup "$CLAUDE_BIN" -p "$PROMPT" \
  --permission-mode bypassPermissions \
  > "$LOG" 2>&1 < /dev/null &

echo "[autoslides] 🎉 queued a deck for commit $SHA (log: ${LOG#$REPO/})"
exit 0
